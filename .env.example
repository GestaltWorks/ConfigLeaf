# Copy to .env and fill in. .env is gitignored; never commit real values.

# Nightshift (Meterless runtime) OpenAI-compatible endpoint
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Leave blank to read %LOCALAPPDATA%\ai.meterless.runtime\proxy-token at runtime
METERLESS_RUNTIME_TOKEN=
METERLESS_APP_ID=drift-agent
# Nemotron through Nightshift. Primary routes are Nemotron via OpenRouter (measured 12/12, 1-2 s);
# fallbacks are NVIDIA's free endpoint, then a local Lightning if its weights are installed.
METERLESS_MODEL_FAST=openrouter/nvidia/nemotron-3.5-lightning
METERLESS_MODEL_JUDGE=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
METERLESS_FALLBACK_FAST=nvidia/nemotron-3.5-lightning-30b-a3b,local-runtime/nemotron-3.5-lightning-30b-a3b
METERLESS_FALLBACK_JUDGE=nvidia/nemotron-3-ultra-550b-a55b

# Zetaris Lightning SQL REST API (local bundle)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Create in the Zetaris UI: Management > API tokens
ZETARIS_API_KEY=
# Lightning datasource the Postgres is registered as; catalogue SQL renders {{t:x}} as <datasource>.x
ZETARIS_DATASOURCE=DRIFT
# The app Postgres as the Zetaris driver container reaches it, host[:port] (5432 when absent): the
# container name on the zetaris_default network, not DATABASE_URL's host. npm run zetaris:setup builds
# CREATE DATASOURCE from it plus DATABASE_URL's user, password and database.
ZETARIS_PG_HOST=drift-pg

# Cloudflare API token for the DNS and audit-log collector, read-only: Zone:Read, DNS:Read,
# Account:Audit Logs:Read. The collector only GETs; nothing it reads is stored unredacted.
CLOUDFLARE_API_TOKEN=

# The app Postgres as this machine reaches it, postgresql://drift:<password>@127.0.0.1:15432/drift
# (drift-pg is published on 127.0.0.1:15432). Blank = not set; nothing live needs it in sample mode.
DATABASE_URL=

# Salt behind the redactor's pseudonyms (ip-XXXXXX, host-XXXXXX, user-XXXXXX). Treat it as a secret:
# with it a published fixture can be re-identified, so it stays out of fixtures, traces and commits.
# Blank = a fresh random salt per process (pseudonyms stable within a run, not across runs).
REDACT_SALT=
# The tenant's own labels, comma-separated: zone labels, product names, the operator's company and host
# nicknames, anything that turns up in file names, timer units, folder names and comments
# (<brand>-prod.conf, /var/www/<product>/, "# <company> apps"). A bare label is not a hostname, so the
# redactor's host pass leaves it; this list makes each one word-XXXXXX. Labels are configuration: a new
# product or brand needs an entry here before the next collection. Blank = no label pass.
REDACT_WORDS=
# Tokens that must never appear in an exported bundle or the committed tree, beyond REDACT_WORDS: the
# operator's mailbox local part, real public addresses, the WireGuard prefix (10.x.y). export:bundle refuses
# a file where one of these or a REDACT_WORDS entry still stands alone; test/leak.test.ts scans the tree.
EXPORT_DENY_WORDS=
# The hosts the Linux collector may reach: <ssh_config alias>=<backup export dir>, comma-separated, for
# example LINUX_HOSTS=host-redacted=/var/backups/export,host-redacted=/home/<login>/backup-export (with the real login).
# The aliases are the operator's own; the export dir is where the host's nightly server-config tarball lands
# (a login's home path lives here, not in source). Blank = the collector reaches nothing; sample mode needs none.
LINUX_HOSTS=

# The vault: a folder outside the repository holding one git repository per tenant and host alias, the
# collected files at their real paths, one commit per completed collection run. Blank = the vault is off.
DRIFT_VAULT_DIR=
# The MSP's policy as data (globs, criticality, lock, what to do on drift), loaded with npm run policy:load
# and read by the Decider. Default policy/hackathon.json.
DRIFT_POLICY_FILE=policy/hackathon.json
# The nginx -t command a vault copy is validated with, {dir} standing for the materialised tree. Blank = the
# platform default: docker run of nginx:1.27, through wsl.exe -d Ubuntu-24.04 on Windows.
DRIFT_NGINX_T=

# true = run the real logic against bundled sample data, no credentials needed
SAMPLE_MODE=false
