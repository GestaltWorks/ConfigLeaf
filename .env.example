# Copy to .env and fill in. .env is gitignored; never commit real values.

# Nightshift (Meterless runtime) OpenAI-compatible endpoint
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Leave blank to read %LOCALAPPDATA%\ai.meterless.runtime\proxy-token at runtime
METERLESS_RUNTIME_TOKEN=
METERLESS_APP_ID=drift-agent
# Nemotron through Nightshift. Primary routes are Nemotron via OpenRouter (measured 12/12, 1-2 s);
# fallbacks are NVIDIA's free endpoint, then a local Lightning if its weights are installed.
METERLESS_MODEL_FAST=openrouter/nvidia/nemotron-3.5-lightning
METERLESS_MODEL_JUDGE=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
METERLESS_FALLBACK_FAST=nvidia/nemotron-3.5-lightning-30b-a3b,local-runtime/nemotron-3.5-lightning-30b-a3b
METERLESS_FALLBACK_JUDGE=nvidia/nemotron-3-ultra-550b-a55b

# Zetaris Lightning SQL REST API (local bundle)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Create in the Zetaris UI: Management > API tokens
ZETARIS_API_KEY=

# true = run the real logic against bundled sample data, no credentials needed
SAMPLE_MODE=false
