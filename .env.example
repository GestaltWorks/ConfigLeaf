# Copy to .env and fill in. .env is gitignored; never commit real values.

# Nightshift (Meterless runtime) OpenAI-compatible endpoint
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Leave blank to read %LOCALAPPDATA%\ai.meterless.runtime\proxy-token at runtime
METERLESS_RUNTIME_TOKEN=
METERLESS_APP_ID=drift-agent
# Nemotron through Nightshift. Lightning calls NVIDIA's endpoint first and OpenRouter second (measured 26 Oct 2026: 5 of 6
# against 1 of 6); Ultra calls OpenRouter first and NVIDIA's endpoint second. A local lane joins the ladder when its
# weights are installed: append ,local-runtime/nemotron-3.5-lightning-30b-a3b to METERLESS_FALLBACK_FAST.
METERLESS_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_MODEL_JUDGE=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
METERLESS_FALLBACK_FAST=openrouter/nvidia/nemotron-3.5-lightning
METERLESS_FALLBACK_JUDGE=nvidia/nemotron-3-ultra-550b-a55b

# Zetaris Lightning SQL REST API (local bundle)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Create in the Zetaris UI: Management > API tokens
ZETARIS_API_KEY=
# Lightning datasource the Postgres is registered as; catalogue SQL renders {{t:x}} as <datasource>.x
ZETARIS_DATASOURCE=DRIFT
# The app Postgres as the Zetaris driver container reaches it, host[:port] (5432 when absent): the
# container name on the zetaris_default network (DATABASE_URL names the host as this machine reaches it).
# npm run zetaris:setup builds CREATE DATASOURCE from it plus DATABASE_URL's user, password and database.
ZETARIS_PG_HOST=drift-pg
# The Zetaris driver container npm run zetaris:setup writes the LESSONS and RULES files into with docker, and on
# Windows the WSL distribution docker runs in (wsl.exe -d <distro> -e docker ...). Blank: the defaults below.
ZETARIS_DRIVER_CONTAINER=zetaris-driver-1
ZETARIS_WSL_DISTRO=Ubuntu-24.04
# How many of the pass's reads run at once (src/pipeline.ts), 1 = one at a time, every decision the same; default 4.
PASS_CONCURRENCY=4

# Cloudflare API token for the DNS and audit-log collector, read-only: Zone:Read, DNS:Read,
# Account:Audit Logs:Read. The collector's requests are GETs, and it redacts every row before it is stored.
CLOUDFLARE_API_TOKEN=

# The app Postgres as this machine reaches it, postgresql://drift:<password>@127.0.0.1:15432/drift
# (drift-pg is published on 127.0.0.1:15432). Blank in sample mode; the live commands that read or write the app
# Postgres need it.
DATABASE_URL=

# Salt behind the redactor's pseudonyms (ip-XXXXXX, host-XXXXXX, user-XXXXXX). Treat it as a secret:
# with it a published fixture can be re-identified, so it stays out of fixtures, traces and commits.
# Blank = a fresh random salt per process (pseudonyms stable within a run, not across runs).
REDACT_SALT=
# The tenant's own labels, comma-separated: zone labels, product names, the operator's company and host
# nicknames, anything that turns up in file names, timer units, folder names and comments
# (<brand>-prod.conf, /var/www/<product>/, "# <company> apps"). A bare label is not a hostname, so the
# redactor's host pass leaves it; this list makes each one word-XXXXXX. Labels are configuration: a new
# product or brand needs an entry here before the next collection. Blank = no label pass.
REDACT_WORDS=
# Tokens that must never appear in an exported bundle or the committed tree, beyond REDACT_WORDS: the
# operator's mailbox local part, real public addresses, the WireGuard prefix (10.x.y), and the login names of
# the hosts in LINUX_HOSTS (a config comment such as "htpasswd -c <file> <login>" carries one into the bundle).
# export:bundle refuses a file where one of these or a REDACT_WORDS entry still stands alone; test/leak.test.ts
# scans the tree with these, REDACT_WORDS and the LINUX_HOSTS aliases.
EXPORT_DENY_WORDS=
# The hosts the Linux collector may reach: <ssh_config alias>=<backup export dir>, comma-separated, for
# example LINUX_HOSTS=web-01=/var/backups/export,web-02=/home/<login>/backup-export (with the real login).
# The aliases are the operator's own; the export dir is where the host's nightly server-config tarball lands
# (a login's home path lives here, not in source). Blank = the collector reaches nothing; sample mode needs none.
LINUX_HOSTS=
# The ssh_config file the aliases in LINUX_HOSTS are read from (every ssh session gets -F <file>; lab/README.md).
# Blank = the user's own (~/.ssh/config).
LINUX_SSH_CONFIG=

# The vault: a folder outside the repository holding one git repository per tenant and host alias, the
# collected files at their real paths, one commit per completed collection run. Blank = the vault is off.
DRIFT_VAULT_DIR=
# The MSP's policy as data (globs, criticality, lock, what to do on drift), loaded with npm run policy:load
# and read by the Decider. Default policy/hackathon.json.
DRIFT_POLICY_FILE=policy/hackathon.json
# The directory of the technician's lessons, the H-MEM store: npm run answer writes it, every pass reads it.
# Blank = .world/memory, gitignored (examples/memory in sample mode, npm run examples and npm run site); a committed
# directory makes a clean clone and CI decide with the same lessons.
DRIFT_MEMORY_DIR=examples/memory
# The nginx -t command a vault copy is validated with, {dir} standing for the materialised tree. Blank = the
# platform default: docker run of nginx:1.27, through wsl.exe -d Ubuntu-24.04 on Windows.
DRIFT_NGINX_T=
# A lab aid (lab/README.md), set on the command line for a lab run and left blank here: the probe population as
# <name>=<address>[:<port>], comma-separated, port 80 when absent, for example
# PROBE_TARGETS_OVERRIDE=lab.example=127.0.0.1:18080,www.lab.test=127.0.0.1:18080. When set, every probe run (npm run
# probe, the cycle's probe step, the Actor's verification after a write) probes these names and skips the Cloudflare
# read, and the trace says so: http is GET http://<address>:<port>/ with the name as Host, recorded "over plain http
# ... (override)"; dns holds the override's address, "override" in its strings; tls is recorded skipped, "skipped:
# no TLS on this target", and counts neither way. Blank = the account's A, AAAA and CNAME records.
PROBE_TARGETS_OVERRIDE=
# The GitHub repository that holds the tickets, as owner/name.
# The token comes from gh auth token at run time and is held in memory only.
DRIFT_TICKETS_REPO=

# true = run the real logic against bundled sample data, no credentials needed
SAMPLE_MODE=false
