#!/bin/sh
# drift-restic-snapshots: runs as root through sudo (ops/sudoers/drift-collector), called only by
# drift-collect for the "restic snapshots --json" request. Loads the repository location, the password
# file path and any backend credentials from the root-only env file, then lists snapshots. Takes no
# arguments. Nothing from the env file is printed; restic's own JSON is the only output.
set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

[ "$#" -eq 0 ] || { printf 'refused\n' >&2; exit 2; }

# /etc/drift-collector/restic.env, root 0600: RESTIC_REPOSITORY=... RESTIC_PASSWORD_FILE=... and the like.
set -a
. /etc/drift-collector/restic.env
set +a

exec /usr/bin/restic snapshots --json --no-lock
