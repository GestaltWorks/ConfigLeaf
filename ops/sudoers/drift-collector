# /etc/sudoers.d/drift-collector (root:root, 0440)
# Root reads the drift-collector user may perform without a password, and nothing else. One line: the
# helper /usr/local/bin/drift-root-reads (ops/ssh/drift-root-reads), which the forced command
# /usr/local/bin/drift-collect (ops/ssh/drift-collect) calls once per session. That script is the only
# thing the collector key can run, and it never calls sudo for anything not listed here.
# Validate before installing:  visudo -c -f ops/sudoers/drift-collector

# The forced command runs with no-pty, so there is no tty for sudo to insist on.
Defaults:drift-collector !requiretty

# Reads the backup export folder (listing, plain nginx copies, the etc/nginx members of the newest
# server-config-<date>.tar.gz through tar -xO | sha256sum) and the certbot renewal configs as root, and
# prints them in the collector's section protocol. A dedicated non-root user needs this for
# /etc/letsencrypt/renewal (0700 root by default) and for any export folder that is root-gathered. The
# empty string means it may be called with no arguments only; the script refuses any argument itself.
drift-collector ALL=(root) NOPASSWD: /usr/local/bin/drift-root-reads ""

# Not listed because the login user reads them directly (measured 24 Oct 2026 on both hosts with the
# operator's own login): hostname, ip addr, /etc/nginx/nginx.conf, conf.d, sites-available,
# sites-enabled and the files they include, systemctl list-timers. In those runs the export folders
# (/var/backups/export, /home/<login>/backup-export) and /etc/letsencrypt/renewal were readable too, so
# nothing above was exercised; it is what the dedicated user will need. No etckeeper, no restic on
# either host, so no lines for them.
