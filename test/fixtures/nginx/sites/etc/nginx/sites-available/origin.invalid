server {
    listen 443 ssl http2;
    server_name origin.invalid www.origin.invalid;

    # Origin certificate issued by the CDN: trusted by the CDN's edge, by no browser. This vhost is
    # correct only while its records stay proxied.
    ssl_certificate     /etc/ssl/cdn-origin/origin.invalid.pem;
    ssl_certificate_key /etc/ssl/cdn-origin/origin.invalid.key;

    location / {
        proxy_pass http://127.0.0.1:4000;
    }

    location /ws/ {
        proxy_pass http://backend_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

upstream backend_ws {
    server 127.0.0.1:4001;
}
