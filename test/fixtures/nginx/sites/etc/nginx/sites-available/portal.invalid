# portal.invalid: proxied through the CDN; the edge's ranges are trusted so logs and limits see the
# visitor. Flipped to proxied on 2026-04-16; www stayed direct until the same change.
server {
    listen 80;
    listen [::]:80;
    server_name portal.invalid www.portal.invalid;
    return 301 https://portal.invalid$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name portal.invalid www.portal.invalid;

    ssl_certificate     /etc/letsencrypt/live/portal.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal.invalid/privkey.pem;

    # CDN edge ranges (documentation addresses stand in for the vendor's published list)
    set_real_ip_from 192.0.2.0/27;
    set_real_ip_from 192.0.2.32/27;
    set_real_ip_from 192.0.2.64/27;
    set_real_ip_from 192.0.2.96/27;
    set_real_ip_from 192.0.2.128/27;
    set_real_ip_from 198.51.100.0/27;
    set_real_ip_from 198.51.100.32/27;
    set_real_ip_from 198.51.100.64/27;
    set_real_ip_from 203.0.113.0/27;
    set_real_ip_from 203.0.113.32/27;
    set_real_ip_from 2001:db8:1::/48;
    set_real_ip_from 2001:db8:2::/48;
    real_ip_header CF-Connecting-IP;

    root /var/www/portal;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
