# portal.invalid, before the CDN
server {
    listen 80;
    listen [::]:80;
    server_name portal.invalid;
    return 301 https://portal.invalid$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name portal.invalid;

    ssl_certificate     /etc/letsencrypt/live/portal.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal.invalid/privkey.pem;

    root /var/www/portal;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host $host;
    }
}
